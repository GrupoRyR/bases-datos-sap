* text=auto eol=lf

# Shell scripts and git hooks must keep LF endings, even on Windows checkouts
.githooks/* text eol=lf
*.sh text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Compiled assets are committed for cPanel (no Node on the server); collapse them in PR diffs.
public/build/** linguist-generated=true

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
