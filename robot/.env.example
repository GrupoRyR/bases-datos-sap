# ==========================================================================
#  BASES DE DATOS SAP - Configuración del robot
#  Copia este archivo como  robot/.env  y rellena los valores reales.
#  El archivo .env NUNCA se sube a Git (ya está en .gitignore).
# ==========================================================================

# --- 1. VPN Sophos Connect -------------------------------------------------
SOPHOS_CLI=C:\Program Files (x86)\Sophos\Connect\sccli.exe
SOPHOS_CONNECTION=20.186.106.194
SOPHOS_USER=
SOPHOS_PASSWORD=
# Segundos de espera a que el túnel levante antes de rendirse
SOPHOS_TIMEOUT=90
# Desconectar la VPN al terminar (true recomendado: el túnel es completo)
SOPHOS_DISCONNECT_AL_FINAL=true

# --- 2. SAP HANA (un usuario por empresa) ----------------------------------
HANA_HOST=
HANA_PORT=30015
# Segundos máximos por consulta
HANA_TIMEOUT=600
# Segurex (SGX)
HANA_SGX_USER=
HANA_SGX_PASSWORD=
HANA_SGX_SCHEMA=SEGUREX
# Soluciones y Derivados (SDC)
HANA_SDC_USER=
HANA_SDC_PASSWORD=
HANA_SDC_SCHEMA=HBT_SDERIVADOS

# --- 3. API de la app (docs/contrato-robot.md) -----------------------------
# Base de la app, solo HTTPS y sin barra final, ej: https://<subdominio>
BASES_SAP_API_URL=
# Llave del robot: el id y el secreto que te da quien administra la app
BASES_SAP_ROBOT_KEY_ID=
BASES_SAP_ROBOT_SECRET=

# --- 4. Carpeta de CSV (fuera del repo) ------------------------------------
BASES_SAP_CSV_DIR=C:\Users\Claude\Documents\CEREBRO\SAP\BASES_DE_DATOS

# --- 5. Horarios ------------------------------------------------------------
# Horas en que corren los otros robots (comparten la VPN). Las solicitudes no
# se atienden 15 minutos antes ni después de cada una.
BASES_SAP_FRANJAS_BLOQUEADAS=00:00,05:00,06:00,12:00,12:30

# --- 6. Archivo ---------------------------------------------------------------
# Historial de documentos (ADOC, ADO1, AJDT, AJD1). Solo actívalo después de
# ver su tamaño en el catálogo.
BASES_SAP_ARCHIVO_HISTORIAL_DOCUMENTOS=false

HANA_SGX_LISTA_PRECIOS=1
HANA_SDC_LISTA_PRECIOS=

HANA_SGX_CUENTAS_CARTERA=13050505,13051005
HANA_SDC_CUENTAS_CARTERA=13050501,13051005

# --- 7. Alertas de error (opcional) ----------------------------------------
# Si se dejan vacías, los errores solo quedan en robot/logs/robot.log.
ALERTA_SMTP_HOST=
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER=
ALERTA_SMTP_PASSWORD=
# Correos separados por comas
ALERTA_DESTINATARIOS=
