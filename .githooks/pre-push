#!/bin/sh
# Blocks any push that creates, updates or deletes main.
# Changes reach main only through pull requests merged on GitHub.
# Enable once per clone: git config core.hooksPath .githooks

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "$protected" ]; then
        echo "pre-push: pushing to main is blocked." >&2
        echo "Push your branch and open a pull request instead." >&2
        exit 1
    fi
done

exit 0
